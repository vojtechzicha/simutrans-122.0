# The fork's platform display and track/stand sign (documentation/fork-platforms-plan.md, section 6), pak128.
# The game draws the panel, the plate and their text; the images are only a foot on the ground.
# Build with the fork's makeobj:  steam-fork.sh platforms  (or: makeobj pak128 OUT.pak platform_objects.dat)
Obj=roadsign
Name=ForkPlatformDisplay-Rail
waytype=track
is_platformdisplay=1
cost=200
intro_year=1900
Image[0]=platform_objects.0.0
Image[1]=platform_objects.0.1
Image[2]=platform_objects.0.2
Image[3]=platform_objects.0.3
cursor=platform_objects.1.0
icon=platform_objects.1.0
